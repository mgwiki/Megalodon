(certificate vampire-megalodon 1
  (problem "core-subsumption-resolution-binary-side")
  (step_proposition "u1" "vampire_or (p) (q)")
  (step_proposition "u2" "vampire_or ((p) -> vampire_false) (q)")
  (step_proposition "u3" "q")
  (step_proposition "u4" "(q) -> vampire_false")
  (step_proposition "u5" "vampire_false")
