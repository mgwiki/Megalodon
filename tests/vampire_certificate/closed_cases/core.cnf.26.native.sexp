  (symbol_declaration "Variable q:prop.")
  (input "u1" (source axiom "a1") (clause (pos (TMH "p")) (pos (TMH "q"))))
  (input "u2" (source axiom "a2") (clause (neg (TMH "p")) (pos (TMH "q"))))
  (subsumption_resolution "u3" (parents "u1" "u2") (selected (pos (TMH "p"))) (side_pivot (neg (TMH "p"))) (subst) (result (clause (pos (TMH "q")))))
  (input "u4" (source axiom "a3") (clause (neg (TMH "q"))))
